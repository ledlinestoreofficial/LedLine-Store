# ============================================================
# LED LINE™ Admin Dashboard - Environment Configuration (.env)
# ============================================================
# All Sanity credentials remain strictly on the server-side.
# Never expose SANITY_WRITE_TOKEN or SANITY_READ_TOKEN to the client.

# 1. Sanity Project Identification
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-03-01

# 2. Authenticated Read Token (Private GROQ Queries)
SANITY_READ_TOKEN=

# 3. Authenticated Write Token (Private Server Actions Mutations)
SANITY_WRITE_TOKEN=

# 4. Optional Admin Security Passkey
ADMIN_SECRET_KEY=ledline_admin_secure_2026
