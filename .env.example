# GEMINI_API_KEY: Required for Gemini AI API calls (Server-only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Sanity Private CMS Configuration (Strictly Server-Only)
SANITY_PROJECT_ID=
SANITY_DATASET="production"
SANITY_API_VERSION="2024-03-01"

# Server-only Authentication Tokens (NEVER prefix with NEXT_PUBLIC_)
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
